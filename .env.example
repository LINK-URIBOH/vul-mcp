PUBLIC_BASE_URL=https://vul.valna.cn
ISSUER_URL=https://vul.valna.cn/auth/realms/vul
HOST_PORT=8001
AUTH_PORT=8081
# Generated by scripts/bootstrap.py; do not paste these values into chat.
POSTGRES_PASSWORD=
VUL_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_PASSWORD=
WEB_CLIENT_SECRET=

# Fill the exact callback displayed in the custom MCP advanced OAuth settings.
MCP_REDIRECT_URI=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Global delivery gate. When true, configure at least one complete channel below.
# Leave ALL SMTP fields below empty to disable email (port/TLS/size can keep defaults).
# Leave BOTH WEBHOOK_URL and WEBHOOK_SECRET empty to disable Webhook.
DELIVERY_ENABLED=false
# Maximum detailed analyses per report. Overflow stays in the persistent backlog.
REPORT_MAX_ITEMS=50
# Date evidence fetch interval (seconds) and successful cache lifetime (hours).
# Evidence fetches share this interval, use at most four concurrent requests,
# and coalesce identical URLs. Discovery APIs retain their own source limits.
PUBLICATION_REQUEST_INTERVAL=1.0
PUBLICATION_CACHE_HOURS=168
# Optional comma-separated original publisher/researcher host allowlist.
# PUBLICATION_REFERENCE_HOSTS=msrc.microsoft.com,support.apple.com,source.android.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_MAX_BYTES=8000000
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_BATCH_SIZE=50
NVD_API_KEY=
GITHUB_TOKEN=
